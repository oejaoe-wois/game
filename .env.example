# No place for environment variables on your host? Copy this file to a file
# named  farm.env  in the server's main folder (next to package.json), fill it
# in, and the server reads it on start. Don't commit farm.env to GitHub.

# ── aio-farm server configuration ──────────────────────────────────────────────
# Copy the values you need into your host's Environment Variables section
# (on Wispbyte: Server → Startup/Env Vars). NEVER commit real values to git.

# REQUIRED — the OWNER's panel login (username + password, NOT a secret key).
# This is YOU. Friends do not share it: once signed in as the owner, open the
# panel's "Users" card and create each friend their own username + password.
# Friends only see/control the game accounts they add; the owner sees all.
# The panel posts them to POST /api/login and gets a session token back
# (kept in the browser only). Sessions live in memory: SESSION_TTL_HOURS
# (default 168 = 7 days), and restarting the server logs everyone out.
# Login attempts are rate-limited (8 tries / 5 min / IP).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password

# OPTIONAL — legacy master token for curl/scripts. If set, it still works
# as X-Admin-Token alongside the username+password login. Leave empty.
ADMIN_TOKEN=

# How long panel sessions last (hours).
SESSION_TTL_HOURS=168

# REQUIRED — master encryption key for the encrypted credential store.
# 32+ random characters. If you lose it, stored passwords become unreadable.
AIO_SECRET_KEY=change-me-to-32-plus-random-characters!!

# ── Game sites ──────────────────────────────────────────────────────────────
# The farm runs accounts on several sites AT THE SAME TIME. Each site gets its
# own hidden fetcher, its own target bus and its own gate/wave list; each
# account is tagged with its site when you add it in the panel.
# Origins (no trailing slash):
GAME_BASE=https://demonicscans.org
VEYRA_BASE=https://veyragame.com
# Veyra stays completely idle (no logins, no requests) until its first account
# is added. By default its fetcher reuses ADMIN_GAME_EMAIL/PASSWORD below; set
# these only if Veyra needs a DIFFERENT fetcher account (set in the host panel,
# never in a committed file):
ADMIN_GAME_EMAIL_VEYRA=
ADMIN_GAME_PASSWORD_VEYRA=
# Different gate/wave list for Veyra (same "path|label" format as WAVE_PAGES).
# Empty = use the same list as the main site.
WAVE_PAGES_VEYRA=

# HTTP port the server listens on
PORT=3000

# Set to 1 on hosts with a reverse proxy (Wispbyte): rate limits and the
# login lockout then count each visitor's real IP, not the proxy's.
TRUST_PROXY=0

# Comma-separated origins allowed to call the API from a browser (CORS).
# Example: https://aio-farm.vercel.app,https://yourname.github.io
# Leave empty to allow any origin (token is still required for every call).
ALLOWED_ORIGINS=

# ── Behaviour tuning ───────────────────────────────────────────────────────────
# Multiply all random delays (2.0 = half speed / gentler, 0.5 = twice as fast).
JITTER_SCALE=1.0

# Stagger between account logins at startup (ms) so N accounts don't sign in
# from the same IP at the same second.
LOGIN_STAGGER_MS=45000   # each SITE staggers its own accounts: account N logs in N x this after boot (sites don't wait on each other)

# How often the scout re-reads the wave pages and refreshes shared targets (ms).
SCOUT_INTERVAL_MS=120000

# Max monster targets written into the game's server-side auto-farm per account.
# (the game's own auto-farm is not used, so no targets are pointed)
MAX_FARM_TARGETS=5

# Pause between hits in combat (ms). The extension used ~1000.
HIT_DELAY_MS=1000

# Random pause between unrelated game requests (ms range).
PACE_MIN_MS=2000
PACE_MAX_MS=8000

# Idle pause between worker cycles (ms range).
CYCLE_MIN_MS=20000
CYCLE_MAX_MS=60000

# Per-request timeout.
REQUEST_TIMEOUT_MS=20000

# After a failed login/re-login, wait this long before trying again (ms).
RELOGIN_COOLDOWN_MS=600000

# Optional legacy knob — IGNORED now. Fetching is fixed: the built-in admin
# fetcher account (ADMIN_GAME_* below) when it is configured, otherwise the
# oldest healthy worker's session.
SCOUT_NICKNAME=

# ── Built-in admin fetcher (the engine's own game account) — OPTIONAL ────────
# When SET: seeded automatically into the encrypted store at boot, HIDDEN from
# every panel/API listing, and permanently THE fetcher: it sweeps every
# gate/wave page and broadcasts the mob ids every other account attacks — and
# it joins the battles it broadcasts about itself (boss caps + precision waves
# only). Users can neither see it, remove it, nor re-point the fetcher, and it
# can never be added to the panel as a fighting account.
#
# When EMPTY/UNSET: the farm runs with NO hidden account — every visible
# account fights, swarms and hunts, and the scout sweeps pages through the
# oldest healthy worker's session. All of your game accounts become fighters.
# Set these ONLY in the Wispbyte environment-variables panel, never in a committed file.
ADMIN_GAME_EMAIL=
ADMIN_GAME_PASSWORD=
ADMIN_GAME_NICKNAME=core-fetcher

# How often each worker re-reads stats.php to refresh its EXP read-out (ms).
# This is the dashboard's "proof of life" — EXP gained + percent bar.
EXP_POLL_MS=300000

# ── Gates & waves (precision wave farming) ──────────────────────────────────
# Every gate serves its own active_wave.php?gate=X&wave=Y pages and each pair
# carries different monsters/values. The engine round-robins the registry:
#   Gate 1           gate=3 · waves 3 / 5 / 8
#   Gate 2 Olympus   gate=5 · wave 9 + the god gates 10-17
# Override the registry WITHOUT editing config/waves.json by listing
# "path|label" pairs here (comma-separated). Leave empty to use the file.
# Example:
# WAVE_PAGES=gate=3&wave=3|Gate 1 wave 1, gate=5&wave=17|Zeus gate
WAVE_PAGES=

# Per-mob damage cap source. Every mob's battle page lists its loot table
# with a "DMG req: X" damage gate per item, and each gate/wave has different
# numbers. Extra damage past the top requirement buys nothing — pure stamina
# waste. The engine stops each mob at exactly its best-loot threshold:
#   auto  (default) = read the mob's battle page once (free, zero stamina),
#           learn its loot gate per mob NAME, persist to data/loot-caps.json;
#           fall back to the measured per-mob / per-wave tables in
#           server/loot.js (Gate 1 w1 70,000 · w2 3.5M · w3 7M · Olympus w1
#           30M · god gates 100M · heralds 1-1.5B · Zeus/Apollo mains 8B)
#   fixed = ignore loot; every mob stops at MOB_DAMAGE_CAP (the original
#           TARGET_DAMAGE behaviour of the live wave script)
MOB_CAP_MODE=auto

# Last-resort per-mob damage stop, used only when the loot gate could not be
# resolved anywhere (and always, in fixed mode). The moment an account's
# cumulative "You:" damage on a mob reaches it, the engine drops the mob and
# moves on. The wave page's "You: X" reading is the resume point.
MOB_DAMAGE_CAP=70000

# ── Per-mob damage FLOOR (the guild contracts' "min 3m dmg" rule) ──────────
# Kill contracts on adventurers_guild.php read "Kill 5 monster(s) · Monster:
# Lizardman Shadowclaw · min 3m dmg" — a kill only COUNTS when the mob died
# with at least that much of YOUR damage on it. The engine parses the active
# contract automatically and raises the floor for that monster (fighting
# past the loot gate until the kill lands). These two knobs let YOU set a
# specific amount of damage for each mob on top:
#   MOB_MIN_DAMAGE       one floor for every mob (0 = off, default)
#   MOB_MIN_DAMAGE_JSON  per-name overrides — matched against the lowercase
#                        mob name, LAST matching rule wins, "*" is the
#                        catch-all. Plain numbers or k/m/b shorthand:
#                        MOB_MIN_DAMAGE_JSON={"*":0,"lizardman":"3m","troll ravager":2500000}
# The active contract's own rule always adds on top (max of both).
MOB_MIN_DAMAGE=0
#MOB_MIN_DAMAGE_JSON={"*":0,"lizardman":"3m"}

# ── Class system (classes.php) ───────────────────────────────────────────────
# Classless accounts farm everything without a class. Once an account hits
# level 200 (every base class's requirement) and is still classless, the
# engine binds the OPTIMAL starting class for farming, ranked by PvE skill
# damage per 200-stamina cast:
#   Mage Fireball 4,000,000 + 10% ATK > Hunter Back Stab 2,700,000 >
#   Warrior Ironclad 1,000,000 > Cleric (no PvE damage skill).
# The in-game choice is PERMANENT — set CLASS_AUTO_PICK=off to disable
# auto-picking for every account, or give one account classPick=off via the
# panel / POST /api/accounts (per-account values win over this default).
#   auto (default) = Mage | warrior | hunter | cleric = a fixed pick | off
#   CLASS_MIN_LEVEL     the level gate (default 200, the game's own rule)
#   CLASS_COOLDOWN_MS   how often the picker re-checks a classless account
CLASS_AUTO_PICK=auto
#CLASS_MIN_LEVEL=200
#CLASS_COOLDOWN_MS=21600000

# ── HTTP transport (Cloudflare) ──────────────────────────────────────────────
# 2026-11: the game sits behind a Cloudflare managed challenge that TLS-
# fingerprints Node's fetch (every request earns a 403 "Just a moment…"
# page, whatever User-Agent it wears). curl's TLS stack passes the same
# edge, so the engine runs its requests through a curl subprocess when one
# exists: same headers, same per-account cookie jar, manual redirects.
#   auto (default) = curl when the binary exists, fetch otherwise
#   curl           = force the curl subprocess (clear error if missing)
#   fetch          = force the old pure-Node path (for self-proxied setups)
CURL_TRANSPORT=auto

# NOTE: the game's own auto-farm (the wave page's autoFarmPanel and its
# auto_farm_actions.php backend) blocks EVERY manual hit while it runs —
# damage.php answers "your auto farm is on". By default the worker now
# PAUSES it itself: reads auto_farm_status.php (settings.IS_ENABLED), sends
# the Auto Farm card's own Pause call (action=toggle&enabled=0), verifies
# with a second read, audits auto_farm_disabled and resumes hunting. It
# checks once at every fresh login too. Brand-new accounts ship with the
# auto-farm ON, so this is what makes them huntable without hand-holding.
# AUTO_FARM_FIX=0 restores the old warn-only behaviour (never toggles).
AUTO_FARM_FIX=1

# Max mobs attacked per worker cycle (each cycle visits ONE wave page).
WAVE_MOBS_PER_ROUND=4

# Pause between wave slashes (ms) — ATTACK_DELAY_MS=650 in the live script.
WAVE_HIT_DELAY_MS=650

# ── Stat allocation (allocatePlan engine) ───────────────────────────────────
# Spends banked stat points through the game's own stats_ajax.php. The server
# only accepts chunks of [100, 50, 5, 1] — the engine decomposes ANY amount
# into exactly those chunks and re-syncs its csrf/view tokens from stats.php
# whenever the game answers 409 (the self-heal the console script does).
#
# STAT_PLAN="stat=amount" pairs (comma-separated). Example — the control the
# console script gives you:  await allocatePlan({stamina: 44444})
# becomes:
# STAT_PLAN=stamina=44444
# or mixed: STAT_PLAN=attack=100,defense=50,stamina=44444
#
# On demand: the panel's "Allocate" button (POST /api/stats/allocate with or
# without an explicit plan — omitting the plan uses STAT_PLAN below).
STAT_PLAN=

# STAT_AUTO_ALLOCATE=1 → every worker runs STAT_PLAN ONCE per session, as soon
# as its stats.php poll sees enough banked STAT_POINTS to cover the plan.
# Insufficient points = keep waiting (re-checked each poll); the plan never
# fires twice in one session. Leave empty to allocate only via the panel/API.
STAT_AUTO_ALLOCATE=0

# ── Stat TARGETS (Veyra auto stat allocator mode) ──────────────────────────
# Instead of fixed amounts, keep spending every banked point until each
# attribute reaches its goal: attack first, then defense, then stamina —
# chunk = largest of [100,50,5,1] that fits min(remaining need, points),
# server truth re-read after every chunk, stops cleanly on targets_reached /
# points_drained.
# STAT_TARGETS=attack=1000,defense=1000,stamina=1000
STAT_TARGETS=

# STAT_TARGETS_AUTO=1 → every worker keeps spending fresh level-up points
# toward STAT_TARGETS (re-armed on every EXP poll; only fires when unspent
# points exist). Leave empty to allocate targets only via the panel/API
# (POST /api/stats/allocate {"targets":{...}}).
STAT_TARGETS_AUTO=0

# ── Boss spawn phases (Boss Tracker port) ───────────────────────────────────
# 48h auto-die bosses embed their true death clock (AUTO_DIE_CFG.nextDieMs)
# on their battle pages. Remaining life > 24h = phase 1 — damage there
# doesn't count, so the workers skip those targets until phase 2.
# BOSS_PHASE_GATE=0 disables the skip (hit bosses as soon as they spawn).
BOSS_PHASE_GATE=1
BOSS_PHASE_TOTAL_HOURS=48
BOSS_PHASE2_HOURS=24

# ── Potions & vitals ────────────────────────────────────────────────────────
# Stamina potion ladder — priority order, first match with quantity wins.
# Names match (case-insensitive substring) the potion cards on battle.php's
# battleDrawer — Small=20, Large=5000(50%), Full=all, Adventurer=50% of
# Atk+Def. Item ids are read per-account from the drawer (data-inv), so
# nothing here needs numbers.
POTION_SLOT_NAMES=small stamina potion,large stamina potion,full stamina potion

# HP potions — same matching rules; used when HP% drops below HP_POTION_BELOW_PCT.
HP_POTION_NAMES=full hp potion

# Proactive vitals (0 disables an auto-action):
#   stamina < STAMINA_POTION_BELOW → drink the stamina ladder (skipped while
#     EXP >= 80% like the extension's AI — a level-up would waste the refill)
#   hp% < HP_POTION_BELOW_PCT      → heal potion, else the free timed heal
# POTION_COOLDOWN_MS spaces out drinks so one low reading can't chain-drink.
STAMINA_POTION_BELOW=50
HP_POTION_BELOW_PCT=30
POTION_COOLDOWN_MS=300000

# Mana watcher (Veyra auto mana): when the battle page's #pManaText drains to
# <= MANA_POTION_BELOW, drink the mana ladder (first match with quantity wins;
# Mana Potion S = +20, Mana Potion L = +200). The default threshold 0 means
# "only when the bar is fully used up", exactly like the script. Set
# MANA_POTION_BELOW=20 to top up earlier.
MANA_POTION_BELOW=0
MANA_POTION_NAMES=mana potion s,small mana potion,mana potion l,large mana potion

# ── Potion shop buy-all (Veyra stamina buy-all) ─────────────────────────────
# When stamina is low (or the drinking ladder came up dry), sweep every
# stamina potion the gold/points can carry, in the extension's order:
#   merchant.php → merchant_buy.php {merch_id, qty}
#   adventurers_guild.php → adventurers_shop_buy.php {shop_item_id} (1/call)
#   olympus_damon_buy.php?action=state → POST {offer, qty}
# POTION_BUY_KINDS picks the merchant kinds the sweep keeps stocked (the
# hunt ladders' stock): stamina (Small/Full/Adventurer Stamina), hp (Full HP
# Potion), mana (Mana Potion S) — default "stamina,hp,mana". Every kind is
# bought with the SAME running gold budget (stamina first, then hp, mana;
# each line is re-aimed at the budget the previous line left behind).
# Gem-priced, unlimited-stock, egg and gear rows are never bulk-bought.
# POTION_BUY=0 disables the automatic sweep (POST /api/shop/stamina works).
POTION_BUY=1
POTION_BUY_COOLDOWN_MS=1800000
POTION_BUY_KINDS=stamina,hp,mana

# ── Dead-boss corpse sweep (Veyra dead bosses + Quick Loot) ─────────────────
# Waves are scanned in the game's show_dead_bosses_only view; every corpse
# this account has damage on (data-userdmg > 0) is collected via
# loot.php {monster_id, user_id, instance_id:'0'}, oldest first.
#   smart  (default) — sweep when the stamina bar is dry OR EXP >= 80%
#           (a level-up refills stamina, so looting near a level is free fuel)
#   always           — a sweep every cycle
#   off              — disabled
CORPSE_LOOT=smart
CORPSE_LOOT_MAX=25
CORPSE_EXP_NEAR_PCT=80
# The LevelUp Looter's autoloot threshold: also sweep when the bar falls
# to this level (0 = only when fully dry).
CORPSE_STAMINA_BELOW=10

# ── Auto-battle potion caps (LevelUp Looter post-level-up step) ───────────
# After a corpse sweep covers the EXP gap (level-up), raise the wave
# page's "Max Large/Full Stamina Potions to use" by this much so the
# in-game auto-battle may drink more per fight. Leave empty to disable.
POTION_CAP_RAISE=

# ── Reaction stamina farm (veyra_stamina_farm port) ─────────────────────────
# Reacts to manga chapters (postreaction.php, +2 stamina each) while the bar
# is below max. The reacted_chap_<id> cookie in each account's jar makes the
# farm restart-safe. REACTION_DAILY_CAP (0 = off) and REACTION_TARGET (stop at
# this stamina) bound it; after REACTION_NO_GAIN_STOP dry stamina checks the
# farm rests for the day. REACTION_FARM=0 disables.
REACTION_FARM=1
REACTION_EMOJI=1
REACTION_BATCH=10
REACTION_DAILY_CAP=0
REACTION_TARGET=0
REACTION_CHECK_EVERY=5
REACTION_NO_GAIN_STOP=4

# ── Guild dungeon farm (DungeonCleaner port) ────────────────────────────────
# guild_dungeon.php → open instances → floors → loot the dead
# (dungeon_loot.php) → join + Slash the live ones (dungeon_join_battle.php /
# damage.php with instance_id + dgmid). DUNGEON_FARM=0 disables;
# DUNGEON_MOBS_PER_CYCLE caps each visit so waves keep their share.
# Cube dungeons (The Polyhedral Crucible) are farmed through their
# guild_dungeon_cube.php STATE: available combat nodes → enter_node POST →
# linked floors. DUNGEON_CUBE=0 skips them again.
DUNGEON_FARM=1
DUNGEON_MOBS_PER_CYCLE=6
DUNGEON_BETWEEN_HITS_MS=300
DUNGEON_CUBE=1

# ── Manual loot of wave kills (event dailies + drops) ──────────────────────
# The moment a wave mob dies, POST loot.php exactly like the game's own Loot
# button. The Dragon Realm event's hunting dailies count only kills that
# were MANUALLY LOOTED ("Auto-Farm and Auto-Loot do not count") and
# unclaimed kills expire without their drops. WAVE_LOOT_KILLS=0 disables
# (the corpse sweep still collects leftovers on its triggers).
WAVE_LOOT_KILLS=1

# ── Achievement + collection claims ─────────────────────────────────────────
# Sweeps achievements.php / collections.php and claims every ENABLED Claim
# button (earned rewards: gold, gems, permanent stat points). Nothing is
# spent; disabled (unearned) buttons are never touched. CLAIMS=0 disables;
# CLAIMS_COOLDOWN_MS spaces the sweeps (claims are earned slowly).
CLAIMS=1
CLAIMS_COOLDOWN_MS=7200000

# ── Adventurers Guild contracts ─────────────────────────────────────────────
# accept → farm → finish loop on adventurers_guild.php. Kill/skill contracts
# complete from normal wave slashing; the engine turns them in and accepts
# the next (kill contracts first). QUESTS_ACCEPT=0 stops new accepts
# (finishing still runs). QUESTS_DONATE=1 opts into donating gather items —
# they are CONSUMED on turn-in, so it is off by default.
GUILD_QUESTS=1
QUESTS_COOLDOWN_MS=1200000
QUESTS_ACCEPT=1
QUESTS_DONATE=0

# ── Guild auto-join ("accept guilds") ────────────────────────────────────────
# An account with a panel guild code that answers GUILD-LESS is joined to that
# exact guild: "Open recruitment" joins instantly, "Application" guilds get an
# application the leader approves later. No code → never join blind.
# GUILD_AUTO_JOIN=0 disables farm-wide.
GUILD_AUTO_JOIN=1
GUILD_JOIN_COOLDOWN_MS=1800000

# ── Event daily contracts (Dragon Realm sanctuary board) ────────────────────
# Discovers live events from the dashboard, reads the Fountain Noticeboard
# (panel=sanctuary:board) for the progress feed and submits the ready
# dispatch choices (one valid choice per contract per day; hidden fields are
# re-read every run so a new day re-arms automatically). Supply contracts are
# never auto-turned-in (items would be consumed). EVENT_DAILIES=0 disables;
# no live event = clean no-op.
EVENT_DAILIES=1
EVENT_DAILIES_COOLDOWN_MS=2700000

# ── Battle Pass (battle_pass.php) ────────────────────────────────────────────
# The season ships two daily quests: "spend 500 stamina" (fills from normal
# farming) and a mob-family damage quest ("deal 300,000 damage to Lizard/Sea
# mobs" — the family rotates per season). While the damage quest is open the
# wave picker prioritizes waves whose mob names match the quest's keywords
# and the matching mobs are attacked first; every ready reward (quests +
# tiers) is claimed with the page's own csrf/endpoint. BATTLE_PASS=0
# disables the whole module; BATTLE_PASS_WAVE_PRIORITY=0 keeps farming
# strictly round-robin; BATTLE_PASS_COOLDOWN_MS spaces the page reads.
# No season live = clean no-op (the engine reads the page and moves on).
BATTLE_PASS=1
BATTLE_PASS_COOLDOWN_MS=1800000
BATTLE_PASS_WAVE_PRIORITY=1

# ── PvP season ladder (Divers pillar 3) ──────────────────────────────────────
# The round reads pvp.php (season title, leaderboard rank, tier, battle
# tokens) and matchmakes ONLY while the season is open and tokens remain
# (POST pvp_matchmake.php {ladder} → follow the battle redirect; one match
# per round by default). A closed season — the live state 2026-11-22,
# "Solo matchmaking is closed." — is a clean no-op that still reports the
# tier/tokens/rank to the panel. PVP=0 disables the pillar; PVP_LADDER
# solo|party; PVP_MAX_MATCHES caps tokens spent per round;
# PVP_COOLDOWN_MS spaces the page reads.
PVP=1
PVP_LADDER=solo
PVP_MAX_MATCHES=1
PVP_COOLDOWN_MS=600000

# ── Divers — the engine's own hunting system (vs the game's auto farmer) ────
# Set per-account "Dive targets" in the panel (accounts page, e.g.
# "goblin skirmisher, troll ravager"): that account hunts EXACTLY those mobs
# — matching cards are attacked FIRST on every page, and the wave picker goes
# straight to the pages the hunt map pins for the targets (seeded from
# config/mobs.json, the live-scraped wave rosters; kept fresh by every parsed
# page). Unknown targets roam the registry until a sweep teaches the map.
# Stale pins self-demote when a round sees none of the targets. DIVE_ONLY=1
# makes divers attack NOTHING but their named mobs (pure target hunting).
# DIVE_ONLY=0 lets them also farm the rest of the page normally.
DIVE_ONLY=0

# ── Fleet hunt ("attack all <mob>", Divers pillar 1, fleet-wide) ─────────────
# Targets page → "Fleet hunt" card (or POST /api/hunt {mob, site?}): the SAME
# dive targets land on EVERY account of the site at once, live. Each account's
# next cycle then BUS-DIVES the matching live mob ids the scout is
# broadcasting (join + slash, whatever wave they live on) and keeps hunting
# the targets on their pinned wave pages over and over. DELETE /api/hunt (or
# the card's Stop button) stands the fleet down. DIVE_BUS=0 turns the instant
# bus dive off (divers then only hunt on their pinned wave pages).
DIVE_BUS=1

# ── Gear keep-up: equip-best + blacksmith (Divers) ───────────────────────────
# Every account periodically wears its best gear and forges what the wave
# drops made craftable:
#   inventory.php?set=<EQUIP_SET> is parsed (equipped slots + bag items);
#   every slot with a STRICTLY better bag item of the same type is re-worn
#   via inventory_ajax.php (equip_item inv_id=<bag id> slot_id=0 set=... —
#   the game's own equip-modal call; "OK" is the only success mark).
#   blacksmith.php?gate=3|5|0 (Grakthar / Olympus / Events) is swept and
#   every recipe the page itself marks craftable (Forge enabled, all material
#   reqs good) is forged via POST craft_item.php {recipe_id}, strongest
#   attack first; new gear is worn right away.
# EQUIP_AUTO=0 / BLACKSMITH_CRAFT=0 disable an automatic round (POST /api/equip
# and POST /api/blacksmith/craft still run them on demand). EQUIP_ATK_WEIGHT /
# EQUIP_DEF_WEIGHT tune the score (score = atk×W_atk + def×W_def; attack
# counts more because kill speed pays the farm's EXP/hour).
EQUIP_AUTO=1
EQUIP_COOLDOWN_MS=900000
EQUIP_SET=attack
EQUIP_ATK_WEIGHT=3
EQUIP_DEF_WEIGHT=1
EQUIP_MAX_PER_ROUND=8
BLACKSMITH_CRAFT=1
BLACKSMITH_COOLDOWN_MS=1800000
BLACKSMITH_MAX_CRAFTS=4

# Optional: Discord webhook URL. When set, the farm pings it on login_fail,
# session_lost and account_degraded events (fire-and-forget, best effort).
# Create one: Server Settings → Integrations → Webhooks → New Webhook → copy URL.
DISCORD_WEBHOOK_URL=

# Optional: override boss damage caps per key, JSON object.
# Example: {"gen":{"c":true,"v":500000000},"oce":{"c":true,"v":3000000000}}
BOSS_CAPS_JSON=

# info | debug | error
LOG_LEVEL=info

# TEST ONLY — shrinks every delay so the local mock test finishes fast.
# NEVER set to 1 on a real deployment.
FAST_TEST=0
